# Copy to .env for local runs. In production these live only in Railway variables.
PORT=3000

# Board settings (tags, private areas, claim rules). Omit for generic defaults.
GIGS_CONFIG=config/anilounge.json

# Discord application (Developer Portal > General Information / Bot)
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GIG_CHANNEL_ID=
DISCORD_DEVELOPER_ROLE_ID=
DISCORD_MAINTAINER_ROLE_ID=

# GitHub App installed on the anilounge org
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
# The Project node id (PVT_...): gh project view <number> --owner <org> --format json --jq .id
GITHUB_PROJECT_ID=

# Postgres (Railway sets this when you attach a database)
DATABASE_URL=
